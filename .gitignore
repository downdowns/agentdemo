node_modules/
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.DS_Store

# Local runtime outputs
logs/

# Local vector database/cache. It can be rebuilt from docs/.
chroma_db/

# Python/tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local notes / drafts not meant for GitHub
local_notes/

# Root-level Markdown notes are treated as local drafts by default.
# Keep README.md for GitHub; business knowledge-base docs under docs/ are still tracked.
/*.md
!/README.md
